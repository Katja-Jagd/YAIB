# Settings for Recurrent Neural Network (RNN) models.

# Common settings for DL models
include "configs/prediction_models/common/DLCommon.gin"

# Dataloader
BATPolarsDataset.runmode = "classification"

# Train params
train_common.model = @BAT
train_common.dataset_class = @BATPolarsDataset
#train_common.precision = 16 # Added to hopefully help with flash attention compatibility with float16 and not float32 


# Optimizer params
optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.weight_decay = 1e-6
optimizer/hyperparameter.lr = (1e-5, 3e-4)

# Encoder params
model/hyperparameter.class_to_tune = @BAT
model/hyperparameter.value_embed_size = [8, 16] # !HAS TO BE EVEN! square brackets mean either of the values and not interval like ()
model/hyperparameter.layers = (1, 2)
model/hyperparameter.heads = (1, 2)
model/hyperparameter.dropout = (0.2, 0.4)
model/hyperparameter.attn_dropout = (0.2, 0.4)
model/hyperparameter.use_mask = False
model/hyperparameter.prediction_head = @BinaryClassificationHead
model/hyperparameter.prediction_head_kwargs = {"num_classes": 2}
model/hyperparameter.pooling = "mean"

# Train params
train_common.epochs = 50
train_common.batch_size = 8
train_common.patience = 10
train_common.min_delta = 1e-4

tune_hyperparameters.scopes = ["model", "optimizer"]  # defines the scopes that the random search runs in
tune_hyperparameters.n_initial_points = 5  # defines random points to initilaize gaussian process
tune_hyperparameters.n_calls = 10  # numbe rof iterations to find best set of hyperparameters
tune_hyperparameters.folds_to_tune_on = 2  # number of folds to use to evaluate set of hyperparameters

