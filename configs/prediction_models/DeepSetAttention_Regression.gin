# Settings for Deep Set Attention (SEFT-based) for regression tasks
# Based on "Set Functions for Time Series" architecture
# Requires: torch_scatter

# Common settings for DL models
include "configs/prediction_models/common/DLCommon.gin"

# Dataloader
train_common.dataset_class = @BATPolarsDataset
BATPolarsDataset.runmode = "regression"

# Loss function for regression
CustomDLPredictionWrapper.loss = @mse_loss

# Train params
train_common.model = @DeepSetAttentionModel
train_common.num_workers = 0
train_common.verbose = True
train_common.cpu = False

# Optimizer params
optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.weight_decay = 1e-6
optimizer/hyperparameter.lr = (1e-5, 1e-3)

# Model params - SEFT architecture hyperparameters
model/hyperparameter.class_to_tune = @DeepSetAttentionModel

# Phi network (element-wise encoding)
model/hyperparameter.seft_n_phi_layers = [1, 2, 3]
model/hyperparameter.seft_phi_width = (64, 128, 256, "log")
model/hyperparameter.seft_phi_dropout = (0.1, 0.3)

# Psi network (set aggregation)
model/hyperparameter.seft_n_psi_layers = [1, 2]
model/hyperparameter.seft_psi_width = (64, 128, 256, "log")
model/hyperparameter.seft_psi_latent_width = (64, 128, 256, "log")

# Attention mechanism
model/hyperparameter.seft_dot_prod_dim = [32, 64, 128]
model/hyperparameter.heads = [2, 4, 8]
model/hyperparameter.attn_dropout = (0.1, 0.3, 0.5)

# Latent representation
model/hyperparameter.seft_latent_width = (64, 128, 256, "log")

# Rho network (final aggregation)
model/hyperparameter.seft_n_rho_layers = [1, 2, 3]
model/hyperparameter.seft_rho_width = (64, 128, 256, "log")
model/hyperparameter.seft_rho_dropout = (0.1, 0.3)

# Positional encoding
model/hyperparameter.seft_max_timescales = 500
model/hyperparameter.seft_n_positional_dims = [8, 16, 32]

# Prediction head
model/hyperparameter.prediction_head = @icu_benchmarks.models.dl_models.bat.RegressionHead
model/hyperparameter.prediction_head_kwargs = {"output_dim": 1}

train_common.epochs = 100
train_common.batch_size = 64
train_common.patience = 10
train_common.min_delta = 1e-4

tune_hyperparameters.scopes = ["model", "optimizer"]
tune_hyperparameters.n_initial_points = 5
tune_hyperparameters.n_calls = 30
tune_hyperparameters.folds_to_tune_on = 1

# CV params
execute_repeated_cv.cv_repetitions = 1
execute_repeated_cv.cv_folds = 5
