# Settings for RadVTransformer (RADV Transformer) models.

# Common settings for DL models
include "configs/prediction_models/common/DLCommon.gin"

# Dataloader
BATPolarsDataset.runmode = "classification"

# Train params
train_common.model = @RadVTransformer
train_common.dataset_class = @BATPolarsDataset
train_common.verbose = True
train_common.cpu = False

# Optimizer params
optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.weight_decay = 1e-6
optimizer/hyperparameter.lr = (1e-5, 1e-3)

# Encoder params
model/hyperparameter.class_to_tune = @RadVTransformer
model/hyperparameter.value_embed_size = [16, 64, 128]  # Must be even
model/hyperparameter.layers = [2, 6, 12]
model/hyperparameter.heads = (1, 2, 4)
model/hyperparameter.dropout = (0.1, 0.2, 0.4)
model/hyperparameter.attn_dropout = (0.1, 0.2, 0.4)
model/hyperparameter.use_mask = False
model/hyperparameter.prediction_head = @icu_benchmarks.models.dl_models.bat.BinaryClassificationHead
model/hyperparameter.prediction_head_kwargs = {"num_classes": 2}
model/hyperparameter.pooling = "max"

train_common.epochs = 25
train_common.batch_size = 2
train_common.patience = 5
train_common.min_delta = 1e-4

tune_hyperparameters.scopes = ["model", "optimizer"]  # defines the scopes that the random search runs in
tune_hyperparameters.n_initial_points = 5  # defines random points to initialize gaussian process
tune_hyperparameters.n_calls = 25  # number of iterations to find best set of hyperparameters
tune_hyperparameters.folds_to_tune_on = 1  # number of folds to use to evaluate set of hyperparameters

# CV params
execute_repeated_cv.cv_repetitions = 1
execute_repeated_cv.cv_folds = 5
