# Settings for SSL GRU-D (Self-Supervised Learning with GRU-D)
# For next token prediction / forecasting pretraining

# Common settings for DL models
include "configs/prediction_models/common/DLCommon.gin"

# Dataset
SSLPolarsDataset.runmode = "regression"
SSLWrapper.clip_grad = True
SSLWrapper.max_grad_norm = 0.5
SSLWrapper.log_grad_norm = True
SSLWrapper.loss = @mse_loss

# Train params
train_common.model = @SSL_GRUD
train_common.weight = "none"  # SSL doesn't use class balancing
train_common.ram_cache = False
train_common.verbose = True
train_common.dataset_class = @SSLPolarsDataset

# Optimizer params
optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.weight_decay = 1e-6
optimizer/hyperparameter.lr = (1e-5, 1e-3)

# Model params
model/hyperparameter.class_to_tune = @SSL_GRUD
model/hyperparameter.recurrent_n_units = (64, 256, "log")
model/hyperparameter.dropout = (0.2, 0.4)
model/hyperparameter.recurrent_dropout = (0.2, 0.4)
model/hyperparameter.pooling = ["hidden", "mean", "max"]
model/hyperparameter.prediction_head = @ForecastingHead
model/hyperparameter.prediction_head_kwargs = {
  "sensors_count": 48,
  "forecast_len": 2,
}

# Train params
train_common.epochs = 10
train_common.batch_size = 64
train_common.patience = 10
train_common.min_delta = 1e-4

tune_hyperparameters.scopes = ["model", "optimizer"]
tune_hyperparameters.n_initial_points = 5
tune_hyperparameters.n_calls = 10
tune_hyperparameters.folds_to_tune_on = 1
