# Settings for SSL_iTransformer (Self-Supervised Learning with Inverted Transformer) models.

# Common settings for DL models
include "configs/prediction_models/common/DLCommon.gin"

# Dataset
SSLPolarsDataset.runmode = "regression"
SSLWrapper.clip_grad = True
SSLWrapper.max_grad_norm = 0.5
SSLWrapper.log_grad_norm = True
SSLWrapper.loss = @mse_loss

# Train params
train_common.model = @SSL_iTransformer
train_common.weight = "none"  # SSLPolarsDataset class does not have a get_balance() method
train_common.ram_cache = False
train_common.verbose = True

# Optimizer params
optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.weight_decay = (1e-6, 1e-4)
optimizer/hyperparameter.lr = (1e-5, 1e-3)

# Encoder params
model/hyperparameter.class_to_tune = @SSL_iTransformer
model/hyperparameter.time_embed_size = [8, 16, 32, 64, 128]
model/hyperparameter.layers = [2, 6, 8, 12]
model/hyperparameter.heads = (1, 2, 4)
model/hyperparameter.dropout = (0.2, 0.6)
model/hyperparameter.attn_dropout = (0.2, 0.6)
model/hyperparameter.use_mask = False
model/hyperparameter.prediction_head = @icu_benchmarks.models.dl_models.bat.ForecastingHead
model/hyperparameter.pooling = "mean"
model/hyperparameter.prediction_head_kwargs = {
  "sensors_count": 48,
  "forecast_len": 2,
}

# Train params
train_common.epochs = 10
train_common.batch_size = 128
train_common.patience = 3
train_common.min_delta = 1e-4

train_common.dataset_class = @SSLPolarsDataset

tune_hyperparameters.scopes = ["model", "optimizer"]  # defines the scopes that the random search runs in
tune_hyperparameters.n_initial_points = 5  # defines random points to initilaize gaussian process
tune_hyperparameters.n_calls = 25  # number of iterations to find best set of hyperparameters
tune_hyperparameters.folds_to_tune_on = 1  # number of folds to use to evaluate set of hyperparameters
