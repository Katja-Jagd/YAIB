# Settings for Transformer model.

# Common settings for DL models
include "configs/prediction_models/common/DLCommon.gin"

# Optimizer params
train_common.model = @Transformer

train_common.num_workers = 0 # To avoid freeze during dataloading 
train_common.dataset_class = @PredictionPolarsDataset # Have to add now in gin after redesign of train_common()

optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.weight_decay = 1e-6
optimizer/hyperparameter.lr = (1e-6, 1e-4)

# Encoder params
model/hyperparameter.class_to_tune = @Transformer
model/hyperparameter.ff_hidden_mult = (1,2,4)
model/hyperparameter.l1_reg = (0.0,1.0)
model/hyperparameter.num_classes = %NUM_CLASSES
model/hyperparameter.hidden = (32, 512, "log")
model/hyperparameter.heads = (1, 3, "log")
model/hyperparameter.depth = (5, 20) 
model/hyperparameter.dropout = (0.0, 0.2) # no improvement (0.0, 0.4)
model/hyperparameter.dropout_att = (0.0, 1.0)

train_common.epochs = 100
train_common.batch_size = 128
train_common.patience = 5
train_common.min_delta = 1e-4

tune_hyperparameters.n_calls = 10  # numbe rof iterations to find best set of hyperparameters
tune_hyperparameters.folds_to_tune_on = 3  # number of folds to use to evaluate set of hyperparameters