# Parameters for Adam:
# ==============================================================================
Adam.amsgrad = False
Adam.betas = (0.9, 0.999)
Adam.capturable = False
Adam.eps = 1e-08
Adam.foreach = None
Adam.lr = 0.0008797495355148973
Adam.maximize = False
Adam.weight_decay = 1e-06

# Parameters for base_classification_preprocessor:
# ==============================================================================
base_classification_preprocessor.generate_features = False
base_classification_preprocessor.load_cache = None
base_classification_preprocessor.scaling = True

# Parameters for BaseModule:
# ==============================================================================
# None.

# Parameters for BATPolarsDataset:
# ==============================================================================
BATPolarsDataset.runmode = 'classification'
BATPolarsDataset.vars = %vars

# Parameters for BinaryClassificationHead:
# ==============================================================================
# None.

# Parameters for CommonPolarsDataset:
# ==============================================================================
CommonPolarsDataset.grouping_segment = 'OUTCOME'
CommonPolarsDataset.mps = False

# Parameters for CustomDLPredictionWrapper:
# ==============================================================================
CustomDLPredictionWrapper.input_size = None

# Parameters for DLWrapper:
# ==============================================================================
DLWrapper.initialization_method = 'normal'
DLWrapper.input_shape = None
DLWrapper.lr_factor = 0.99
DLWrapper.lr_scheduler = None
DLWrapper.lr_steps = None
DLWrapper.momentum = 0.9

# Parameters for execute_repeated_cv:
# ==============================================================================
execute_repeated_cv.cv_folds = 5
execute_repeated_cv.cv_folds_to_train = None
execute_repeated_cv.cv_repetitions = 5
execute_repeated_cv.cv_repetitions_to_train = None
execute_repeated_cv.enable_subset_train = False
execute_repeated_cv.stop_after_first_fold = False
execute_repeated_cv.subset_train_seed = 42
execute_repeated_cv.subset_train_size = 1000
execute_repeated_cv.test_on = 'test'

# Parameters for GRUDEncoder:
# ==============================================================================
GRUDEncoder.activation = 'tanh'
GRUDEncoder.feed_masking = True
GRUDEncoder.hidden_decay = 'exp_relu'
GRUDEncoder.input_decay = 'exp_relu'
GRUDEncoder.masking_decay = None
GRUDEncoder.obs_strategy = 'both'
GRUDEncoder.recurrent_activation = 'hardsigmoid'
GRUDEncoder.use_decay_bias = True
GRUDEncoder.use_static = True
GRUDEncoder.x_imputation = 'zero'

# Parameters for GRUDEncoderPrediction:
# ==============================================================================
# None.

# Parameters for GRUDModel:
# ==============================================================================
GRUDModel.dropout = 0.25779709709561627
GRUDModel.lr = 0.0001
GRUDModel.pooling = 'hidden'
GRUDModel.prediction_head_kwargs = {'num_classes': 2}
GRUDModel.recurrent_dropout = 0.36991766186347613
GRUDModel.recurrent_n_units = 175

# Parameters for model/hyperparameter:
# ==============================================================================
model/hyperparameter.class_to_tune = @GRUDModel
model/hyperparameter.dropout = (0.2, 0.4)
model/hyperparameter.pooling = ['hidden', 'mean', 'max']
model/hyperparameter.prediction_head = \
    @icu_benchmarks.models.dl_models.bat.BinaryClassificationHead
model/hyperparameter.prediction_head_kwargs = {'num_classes': 2}
model/hyperparameter.recurrent_dropout = (0.2, 0.4)
model/hyperparameter.recurrent_n_units = (64, 256, 'log')

# Parameters for optimizer/hyperparameter:
# ==============================================================================
optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.lr = (1e-05, 0.001)
optimizer/hyperparameter.weight_decay = 1e-06

# Parameters for preprocess:
# ==============================================================================
preprocess.add_age_binary = None
preprocess.file_names = \
    {'DYNAMIC': 'dyn.parquet',
     'OUTCOME': 'outc.parquet',
     'STATIC': 'sta.parquet'}
preprocess.label = None
preprocess.modality_mapping = %modality_mapping
preprocess.preprocessor = @base_classification_preprocessor
preprocess.required_segments = ['STATIC', 'DYNAMIC', 'OUTCOME']
preprocess.required_var_types = ['GROUP', 'SEQUENCE', 'LABEL']
preprocess.selected_modalities = 'all'
preprocess.use_static = True
preprocess.vars = %vars

# Parameters for Run:
# ==============================================================================
Run.mode = 'Classification'

# Parameters for train_common:
# ==============================================================================
train_common.batch_size = 64
train_common.dataset_class = @BATPolarsDataset
train_common.dataset_names = {'test': 'hirid', 'train': 'hirid', 'val': 'hirid'}
train_common.epochs = 100
train_common.min_delta = 0.0001
train_common.model = @GRUDModel
train_common.num_workers = 0
train_common.optimizer = @Adam
train_common.patience = 5
train_common.persistent_workers = None
train_common.pl_model = True
train_common.polars = True
train_common.precision = 32
train_common.ram_cache = True
train_common.weight = 'balanced'

# Parameters for tune_hyperparameters:
# ==============================================================================
tune_hyperparameters.checkpoint_file = 'hyperparameter_tuning_logs.db'
tune_hyperparameters.folds_to_tune_on = 3
tune_hyperparameters.n_calls = 10
tune_hyperparameters.n_initial_points = 5
tune_hyperparameters.plot = True
tune_hyperparameters.scopes = ['model', 'optimizer']
